# Private application settings. Copy to .env and restart Streamlit after changes.
# Hostname only: use your own assigned/reserved domain, matching Kaggle's NGROK_DOMAIN secret.
NGROK_DOMAIN=your-assigned-domain.ngrok-free.dev
ATS_API_KEY=the-same-secret-as-Kaggle-ATS_API_KEY

# The app builds https://<NGROK_DOMAIN> automatically.
# Optional full base URL override for development or another endpoint:
# ATS_API_URL=http://localhost:8000

# CVs, profiles and vectors persist in .data/candidates.sqlite3 by default.
# Optional override (private developer setting):
# ATS_DATA_DIR=D:/path/to/private-candidate-library
